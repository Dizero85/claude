# Copy to .env and fill in for real deployments. Nothing here is required to
# run locally — every value has a safe fallback (see src/config.js).

PORT=3000
DATABASE_PATH=./data/wardwell.sqlite

# --- Email alerts (court-watch + rule notifications) ---
# If SMTP_HOST is unset, alerts are logged to the console and the DB only —
# no email is sent. This lets the pilot run with zero setup.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_FROM=alerts@wardwell.local
ALERT_TO=coordinator@example.com

# --- Court watch ---
# "mock" is a deterministic fake provider safe to run anywhere (default,
# used in tests and local dev). "utah" hits the real public Utah courts
# calendar and has NOT been verified against the live site from this
# environment — see README "Court watch: what's real" before switching to it.
COURT_WATCH_PROVIDER=mock
COURT_WATCH_ENABLED=false
